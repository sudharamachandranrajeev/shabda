<Window x:Class="Shabda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shabda — Windows sound doctor" Height="720" Width="1100" MinHeight="480" MinWidth="760"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel LastChildFill="True">
                <Button x:Name="ScanButton" DockPanel.Dock="Left" Padding="16,6" Click="Scan_Click"
                        AutomationProperties.Name="Scan this PC for sound problems">Scan this PC</Button>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <RadioButton x:Name="DetectedMode" IsChecked="True" Checked="Mode_Changed" Margin="0,0,12,0">Detected problems</RadioButton>
                    <RadioButton x:Name="AllMode" Checked="Mode_Changed">All known issues</RadioButton>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="260" Padding="4" TextChanged="Search_Changed"
                         AutomationProperties.Name="Search issues" ToolTip="Search symptoms, e.g. bluetooth no sound"/>
                <TextBlock Text="Search" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock/>
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Press Scan to check this PC. Scanning only reads settings; it changes nothing."/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="IssueList" SelectionChanged="IssueList_SelectionChanged" BorderThickness="0"
                     AutomationProperties.Name="Issues" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.75" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="20,12">
                <StackPanel x:Name="Detail"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
